{
  "name": "meisan-quest",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "art:list": "node scripts/gen-art-list.mjs",
    "art:check": "node scripts/check-art-svg.mjs",
    "test:e2e": "vite build && node e2e/run.mjs",
    "build:app": "tsc --noEmit && vite build --base ./",
    "cap:sync": "npm run build:app && cap sync"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/cli": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@capacitor/ios": "^8.5.0",
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "@svg-maps/japan": "^2.0.0",
    "@types/node": "^26.1.1",
    "playwright": "^1.61.1",
    "topojson-client": "^3.1.0",
    "typescript": "^7.0.2",
    "vite": "^8.1.4",
    "vitest": "^4.1.10"
  }
}
